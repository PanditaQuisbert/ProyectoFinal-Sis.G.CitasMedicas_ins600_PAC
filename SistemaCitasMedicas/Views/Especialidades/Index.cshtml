@model IEnumerable<SistemaCitasMedicas.Datos.Entidades.Especialidad>
@{ ViewData["Title"] = "Especialidades"; string buscar = ViewBag.Buscar as string ?? ""; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div><h2 class="mb-1">Especialidades médicas</h2><p class="app-muted mb-0">Administración de especialidades del centro de salud.</p></div>
    <a asp-action="Create" class="btn btn-primary">Nueva especialidad</a>
</div>
<div class="app-card p-3 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-6"><label class="form-label">Buscar</label><input name="buscar" value="@buscar" class="form-control" placeholder="Nombre o descripción" /></div>
        <div class="col-md-6 d-flex gap-2"><button class="btn btn-outline-primary" type="submit">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
    </form>
</div>
<div class="app-card p-0 overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
<thead class="table-light"><tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
<tbody>
@if(!Model.Any()){<tr><td colspan="4" class="text-center py-4 app-muted">No hay especialidades registradas.</td></tr>}
else{foreach(var e in Model){<tr>
<td>@e.Nombre</td><td>@e.Descripcion</td>
<td>@(e.Activo ? Html.Raw("<span class='badge bg-success'>Activa</span>") : Html.Raw("<span class='badge bg-secondary'>Inactiva</span>"))</td>
<td class="text-end">
  <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Editar</a>
  <form asp-action="CambiarEstado" method="post" class="d-inline" onsubmit="return confirm('¿Confirmar cambio de estado?');">
    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"/><input type="hidden" name="activo" value="@(!e.Activo)"/>
    <button class="btn btn-sm @(e.Activo?"btn-outline-warning":"btn-outline-success")" type="submit">@(e.Activo?"Desactivar":"Activar")</button>
  </form>
</td></tr>}}
</tbody></table></div></div>