@model SistemaCitasMedicas.ViewModels.CitaFiltroViewModel
@using SistemaCitasMedicas.Datos.Entidades
@{
    ViewData["Title"] = "Citas médicas";
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div><h2 class="mb-1">Citas médicas</h2><p class="app-muted mb-0">Consulta, programación y gestión de citas.</p></div>
  <a asp-action="Create" class="btn btn-primary">Programar cita</a>
</div>
<div class="app-card p-3 mb-3">
  <form method="get" class="row g-2 align-items-end">
    <div class="col-md-2"><label asp-for="Fecha" class="form-label"></label><input asp-for="Fecha" type="date" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label">Documento paciente</label><input asp-for="DocumentoPaciente" class="form-control" placeholder="Documento" /></div>
    <div class="col-md-2"><label class="form-label">Especialidad</label>
      <select name="EspecialidadId" class="form-select"><option value="">Todas</option>@foreach(var e in Model.Especialidades){<option value="@e.Id" selected="@(Model.EspecialidadId==e.Id)">@e.Nombre</option>}</select>
    </div>
    <div class="col-md-2"><label class="form-label">Médico</label>
      <select name="MedicoId" class="form-select"><option value="">Todos</option>@foreach(var m in Model.Medicos){<option value="@m.Id" selected="@(Model.MedicoId==m.Id)">@m.NombreCompleto</option>}</select>
    </div>
    <div class="col-md-2"><label class="form-label">Estado</label>
      <select name="Estado" class="form-select"><option value="">Todos</option>@foreach(var s in EstadosCita.Todos){<option value="@s" selected="@(Model.Estado==s)">@s</option>}</select>
    </div>
    <div class="col-md-2 d-flex gap-2"><button class="btn btn-outline-primary w-100" type="submit">Filtrar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
  </form>
</div>

<div class="app-card p-0 overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
<thead class="table-light"><tr><th>Fecha y hora</th><th>Paciente</th><th>Médico</th><th>Especialidad</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
<tbody>
@if(!Model.Resultados.Any()){<tr><td colspan="6" class="text-center py-4 app-muted">No se encontraron citas.</td></tr>}
else{foreach(var c in Model.Resultados){
  var badge = c.Estado==EstadosCita.Programada?"bg-primary":c.Estado==EstadosCita.Atendida?"bg-success":"bg-secondary";
<tr>
  <td>@c.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
  <td>@c.Paciente?.NombreCompleto<br/><small class="app-muted">@c.Paciente?.Documento</small></td>
  <td>@c.Medico?.NombreCompleto</td>
  <td>@c.Medico?.Especialidad?.Nombre</td>
  <td><span class="badge @badge">@c.Estado</span></td>
  <td class="text-end">
    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
    @if(c.Estado!=EstadosCita.Cancelada){<a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Modificar</a>}
    @if(c.Estado!=EstadosCita.Cancelada){
      <form asp-action="Cancelar" method="post" class="d-inline" onsubmit="return confirm('¿Cancelar esta cita? El horario quedará disponible.');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id"/><button class="btn btn-sm btn-outline-danger" type="submit">Cancelar</button></form>
    }
  </td>
</tr>}}
</tbody></table></div></div>