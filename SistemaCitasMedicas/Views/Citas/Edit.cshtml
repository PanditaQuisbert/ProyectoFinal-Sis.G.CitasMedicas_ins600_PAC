@model SistemaCitasMedicas.ViewModels.CitaFormViewModel
@{ ViewData["Title"] = "Modificar cita"; }
<h2>Modificar cita médica</h2>
<p class="app-muted">Puede cambiar paciente, médico, especialidad, fecha, hora y observaciones. Se volverá a verificar la disponibilidad.</p>
<hr />
<div class="app-card p-4">
  <form asp-action="Edit" method="post" id="formCita" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6">
      <label asp-for="PacienteId" class="form-label"></label>
      <select asp-for="PacienteId" class="form-select">
        @foreach (var p in Model.Pacientes){<option value="@p.Id" selected="@(p.Id==Model.PacienteId)">@p.Documento - @p.NombreCompleto</option>}
      </select>
      <span asp-validation-for="PacienteId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
      <label asp-for="EspecialidadId" class="form-label"></label>
      <select asp-for="EspecialidadId" class="form-select" id="EspecialidadId">
        @foreach (var e in Model.Especialidades){<option value="@e.Id" selected="@(e.Id==Model.EspecialidadId)">@e.Nombre</option>}
      </select>
      <span asp-validation-for="EspecialidadId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
      <label asp-for="MedicoId" class="form-label"></label>
      <select asp-for="MedicoId" class="form-select" id="MedicoId" data-selected="@Model.MedicoId">
        @foreach (var m in Model.Medicos){<option value="@m.Id" selected="@(m.Id==Model.MedicoId)">@m.NombreCompleto (@m.Matricula)</option>}
      </select>
      <span asp-validation-for="MedicoId" class="text-danger"></span>
    </div>
    <div class="col-md-3">
      <label asp-for="Fecha" class="form-label"></label>
      <input asp-for="Fecha" type="date" class="form-control" id="Fecha" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
      <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>
    <div class="col-md-3">
      <label asp-for="Hora" class="form-label"></label>
      <select asp-for="Hora" class="form-select" id="Hora" data-selected="@Model.Hora"></select>
      <span asp-validation-for="Hora" class="text-danger"></span>
      <small id="dispMsg" class="d-block mt-1"></small>
    </div>
    <div class="col-12">
      <label asp-for="Observaciones" class="form-label"></label>
      <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
      <span asp-validation-for="Observaciones" class="text-danger"></span>
    </div>
    <div class="col-12">
      <button type="button" id="btnVerificar" class="btn btn-outline-info">Verificar disponibilidad</button>
      <button type="submit" class="btn btn-primary">Guardar cambios</button>
      <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
  </form>
</div>
@section Scripts {
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
<script>
(function(){
  const esp = document.getElementById('EspecialidadId');
  const med = document.getElementById('MedicoId');
  const fecha = document.getElementById('Fecha');
  const hora = document.getElementById('Hora');
  const msg = document.getElementById('dispMsg');
  const btn = document.getElementById('btnVerificar');
  const citaId = '@Model.Id';
  function slots(){ const arr=[]; for(let h=8; h<=17; h++){ for(let m of [0,30]){ if(h===17 && m>0) continue; arr.push(String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')); } } return arr; }
  function renderHoras(ocupados){
    const sel = hora.dataset.selected || hora.value; hora.innerHTML='';
    slots().forEach(s=>{ const o=ocupados.includes(s); const opt=document.createElement('option'); opt.value=s; opt.textContent=s+(o?' (ocupado)':''); opt.disabled=o; if(s===sel) opt.selected=true; hora.appendChild(opt); });
    if(!hora.value){ const first=[...hora.options].find(o=>!o.disabled); if(first) first.selected=true; }
  }
  renderHoras([]);
  async function cargarMedicos(preservar){
    const id = esp.value; const selected = preservar ? (med.dataset.selected || med.value) : '';
    med.innerHTML='<option value="">Seleccione un médico</option>'; if(!id) return;
    const res = await fetch(`@Url.Action("MedicosPorEspecialidad")?especialidadId=${id}`); const data = await res.json();
    data.forEach(m=>{ const o=document.createElement('option'); o.value=m.id; o.textContent=`${m.nombre} (${m.matricula})`; if(String(m.id)===String(selected)) o.selected=true; med.appendChild(o); });
  }
  async function cargarDisponibilidad(){ if(!med.value || !fecha.value){ renderHoras([]); return; } const res = await fetch(`@Url.Action("Disponibilidad")?medicoId=${med.value}&fecha=${fecha.value}&excluirCitaId=${citaId}`); const data = await res.json(); renderHoras(data.ocupados||[]); }
  async function verificar(){ msg.textContent=''; msg.className='d-block mt-1'; if(!med.value||!esp.value||!fecha.value||!hora.value){ msg.textContent='Complete especialidad, médico, fecha y hora.'; msg.classList.add('text-warning'); return; } const res = await fetch(`@Url.Action("Validar")?medicoId=${med.value}&especialidadId=${esp.value}&fecha=${fecha.value}&hora=${hora.value}&excluirCitaId=${citaId}`); const data = await res.json(); msg.textContent=data.mensaje; msg.classList.add(data.ok?'text-success':'text-danger'); }
  esp.addEventListener('change', async ()=>{ med.dataset.selected=''; await cargarMedicos(false); await cargarDisponibilidad(); });
  med.addEventListener('change', cargarDisponibilidad);
  fecha.addEventListener('change', cargarDisponibilidad);
  btn.addEventListener('click', verificar);
  cargarDisponibilidad();
})();
</script>
}