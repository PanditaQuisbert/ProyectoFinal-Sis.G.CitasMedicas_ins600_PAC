@model SistemaCitasMedicas.ViewModels.InstalacionAdminViewModel
@{
    Layout = null;
    ViewData["Title"] = "Configuración inicial";
}
<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Configuración inicial - SALUD GESTIÓN</title>
    <script>
        (() => { try { document.documentElement.setAttribute("data-theme", localStorage.getItem("tema-sistema") || "light"); } catch { document.documentElement.setAttribute("data-theme", "light"); } })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html body.auth-body {
            min-height: 100vh;
            padding: 48px 20px;
            background-color: var(--app-bg);
            background-image: radial-gradient(circle at 12% 8%, var(--bg-glow-1), transparent 32rem), radial-gradient(circle at 88% 92%, var(--bg-glow-2), transparent 30rem);
            background-attachment: fixed;
        }
        .setup-card {
            position: relative;
            overflow: hidden;
            border: 1px solid var(--glass-border);
            border-radius: 22px;
            background: var(--glass-bg);
            box-shadow: var(--shadow-hover);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
        .setup-card::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--accent-cyan), var(--accent-violet), transparent);
        }
        .auth-brand-mark {
            width: 52px; height: 52px;
            border-radius: 15px;
            display: grid; place-items: center;
            color: #fff;
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-violet));
            box-shadow: 0 0 24px var(--neon);
        }
    </style>
</head>
<body class="auth-body">
    <svg class="svg-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 21s-8-4.5-8-11a4.5 4.5 0 0 1 8-2.5A4.5 4.5 0 0 1 20 10c0 6.5-8 11-8 11z"/><path d="M8 12h8M12 8v8"/></symbol>
        <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="2.5"/></symbol>
        <symbol id="i-eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18"/><path d="M10.6 6.2A10.9 10.9 0 0 1 12 6c6.4 0 10 6 10 6a17 17 0 0 1-3.3 3.8M6.2 7.8A16.7 16.7 0 0 0 2 12s3.6 6 10 6a10.5 10.5 0 0 0 4.2-.9"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></symbol>
        <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></symbol>
    </svg>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-xl-6">
                <div class="setup-card">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="auth-brand-mark"><svg class="ico ico-lg"><use href="#i-heart"></use></svg></div>
                            <div>
                                <div class="eyebrow">SALUD GESTIÓN</div>
                                <h3 class="page-title mb-0">Configuración inicial</h3>
                            </div>
                        </div>
                        <p class="app-muted">Cree la cuenta del primer administrador. Este paso solo está disponible mientras no existan usuarios en el sistema.</p>
                        <form asp-action="Instalacion" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                            <div class="mb-3">
                                <label asp-for="NombreUsuario" class="form-label"></label>
                                <input asp-for="NombreUsuario" class="form-control" />
                                <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="NombreCompleto" class="form-label"></label>
                                <input asp-for="NombreCompleto" class="form-control" />
                                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Contrasena" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="Contrasena" class="form-control" autocomplete="off" />
                                    <button class="btn btn-outline-secondary toggle-password" type="button" data-target="Contrasena" aria-label="Mostrar contraseña" title="Mostrar contraseña"><svg class="ico"><use href="#i-eye"></use></svg></button>
                                </div>
                                <span asp-validation-for="Contrasena" class="text-danger"></span>
                            </div>
                            <div class="mb-4">
                                <label asp-for="ConfirmarContrasena" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="off" />
                                    <button class="btn btn-outline-secondary toggle-password" type="button" data-target="ConfirmarContrasena" aria-label="Mostrar contraseña" title="Mostrar contraseña"><svg class="ico"><use href="#i-eye"></use></svg></button>
                                </div>
                                <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-success"><svg class="ico ico-sm"><use href="#i-shield"></use></svg> Crear administrador inicial</button>
                            <a asp-action="Login" class="btn btn-outline-secondary ms-2">Volver</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.querySelectorAll('.toggle-password').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.dataset.target);
                var use = btn.querySelector('use');
                if (!input) return;
                var mostrar = input.type === 'password';
                input.type = mostrar ? 'text' : 'password';
                if (use) { use.setAttribute('href', mostrar ? '#i-eye-off' : '#i-eye'); }
                btn.setAttribute('aria-label', mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña');
                btn.setAttribute('title', mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña');
                input.focus();
            });
        });
    </script>
</body>
</html>
