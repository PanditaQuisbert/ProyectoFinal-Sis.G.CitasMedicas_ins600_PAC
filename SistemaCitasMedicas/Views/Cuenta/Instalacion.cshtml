@model SistemaCitasMedicas.ViewModels.InstalacionAdminViewModel
@{
    Layout = null;
    ViewData["Title"] = "Configuración inicial";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Configuración inicial - SALUD GESTIÓN</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { min-height:100vh; background:#f0fdfa; font-family: Inter, 'Segoe UI', sans-serif; }
        .card { border:0; border-radius:16px; box-shadow:0 10px 30px rgba(15,118,110,.12); }
    </style>
</head>
<body class="py-5">
<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body p-4 p-md-5">
                    <h3 class="mb-1" style="color:#0f766e;">Configuración inicial</h3>
                    <p class="text-muted">Cree la cuenta del primer administrador. Este paso solo está disponible mientras no existan usuarios en el sistema.</p>
                    <form asp-action="Instalacion" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                        <div class="mb-3">
                            <label asp-for="NombreUsuario" class="form-label"></label>
                            <input asp-for="NombreUsuario" class="form-control" />
                            <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label"></label>
                            <input asp-for="NombreCompleto" class="form-control" />
                            <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Contrasena" class="form-label"></label>
                            <input asp-for="Contrasena" class="form-control" />
                            <span asp-validation-for="Contrasena" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="ConfirmarContrasena" class="form-label"></label>
                            <input asp-for="ConfirmarContrasena" class="form-control" />
                            <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-success">Crear administrador inicial</button>
                        <a asp-action="Login" class="btn btn-outline-secondary ms-2">Volver</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>