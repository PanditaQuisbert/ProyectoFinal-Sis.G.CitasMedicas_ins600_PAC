@model IEnumerable<SistemaCitasMedicas.Datos.Entidades.Usuario>
@{ ViewData["Title"] = "Usuarios"; string buscar = ViewBag.Buscar as string ?? ""; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div><h2 class="mb-1">Usuarios y roles</h2><p class="app-muted mb-0">Administración de cuentas, roles y estado de acceso.</p></div>
  <a asp-action="Create" class="btn btn-primary">Nuevo usuario</a>
</div>
<div class="app-card p-3 mb-3"><form method="get" class="row g-2 align-items-end"><div class="col-md-6"><label class="form-label">Buscar</label><input name="buscar" value="@buscar" class="form-control" placeholder="Usuario o nombre completo" /></div><div class="col-md-6 d-flex gap-2"><button class="btn btn-outline-primary">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div></form></div>
<div class="app-card p-0 overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
<thead class="table-light"><tr><th>Usuario</th><th>Nombre completo</th><th>Rol</th><th>Estado</th><th>Creado</th><th class="text-end">Acciones</th></tr></thead>
<tbody>
@if(!Model.Any()){<tr><td colspan="6" class="text-center py-4 app-muted">No hay usuarios.</td></tr>}
else{foreach(var u in Model){<tr>
<td>@u.NombreUsuario</td><td>@u.NombreCompleto</td><td>@u.Rol?.Nombre</td>
<td>@(u.Activo?Html.Raw("<span class='badge bg-success'>Activo</span>"):Html.Raw("<span class='badge bg-secondary'>Inactivo</span>"))</td>
<td>@u.FechaCreacion.ToString("dd/MM/yyyy")</td>
<td class="text-end">
  <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Editar</a>
  <form asp-action="CambiarEstado" method="post" class="d-inline" onsubmit="return confirm('¿Confirmar cambio de estado?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"/><input type="hidden" name="activo" value="@(!u.Activo)"/><button class="btn btn-sm @(u.Activo?"btn-outline-warning":"btn-outline-success")" type="submit">@(u.Activo?"Desactivar":"Activar")</button></form>
</td></tr>}}
</tbody></table></div></div>