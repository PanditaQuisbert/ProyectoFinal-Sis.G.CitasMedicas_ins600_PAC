@model SistemaCitasMedicas.ViewModels.UsuarioFormViewModel
@{ ViewData["Title"] = "Nuevo usuario"; }
<h2>Registrar usuario</h2><p class="app-muted">Las contraseñas se almacenan de forma segura mediante hash bcrypt.</p><hr />
<div class="app-card p-4"><form asp-action="Create" method="post" class="row g-3">
@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="col-md-6"><label asp-for="NombreUsuario" class="form-label"></label><input asp-for="NombreUsuario" class="form-control"/><span asp-validation-for="NombreUsuario" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="NombreCompleto" class="form-label"></label><input asp-for="NombreCompleto" class="form-control"/><span asp-validation-for="NombreCompleto" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="RolId" class="form-label"></label><select asp-for="RolId" class="form-select" asp-items="ViewBag.Roles"><option value="">Seleccione un rol</option></select><span asp-validation-for="RolId" class="text-danger"></span></div>
<div class="col-md-6 d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" asp-for="Activo"/><label class="form-check-label" asp-for="Activo"></label></div></div>
<div class="col-md-6">
  <label asp-for="Contrasena" class="form-label"></label>
  <div class="input-group">
    <input asp-for="Contrasena" class="form-control" autocomplete="off" />
    <button class="btn btn-outline-secondary toggle-password" type="button" data-target="Contrasena" aria-label="Mostrar contraseña" title="Mostrar contraseña"><svg class="ico ico-sm"><use href="#i-eye"></use></svg></button>
  </div>
  <span asp-validation-for="Contrasena" class="text-danger"></span>
</div>
<div class="col-md-6">
  <label asp-for="ConfirmarContrasena" class="form-label"></label>
  <div class="input-group">
    <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="off" />
    <button class="btn btn-outline-secondary toggle-password" type="button" data-target="ConfirmarContrasena" aria-label="Mostrar contraseña" title="Mostrar contraseña"><svg class="ico ico-sm"><use href="#i-eye"></use></svg></button>
  </div>
  <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
</div>
<div class="col-12"><button class="btn btn-primary" type="submit">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Volver</a></div>
</form></div>
@section Scripts {
  @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
  <script>
    document.querySelectorAll('.toggle-password').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = document.getElementById(btn.dataset.target);
        if (!input) return;
        var mostrar = input.type === 'password';
        input.type = mostrar ? 'text' : 'password';
        var use = btn.querySelector('use');
        if (use) { use.setAttribute('href', mostrar ? '#i-eye-off' : '#i-eye'); }
        btn.setAttribute('aria-label', mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña');
        btn.setAttribute('title', mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña');
        input.focus();
      });
    });
  </script>
}