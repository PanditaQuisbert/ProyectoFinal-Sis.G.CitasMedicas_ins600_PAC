@model IEnumerable<SistemaCitasMedicas.Datos.Entidades.Paciente>
@{
    ViewData["Title"] = "Pacientes";
    string buscar = ViewBag.Buscar as string ?? "";
    bool incluirInactivos = ViewBag.IncluirInactivos == true;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-1">Pacientes</h2>
        <p class="app-muted mb-0">Registro, búsqueda y administración de pacientes.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Registrar paciente</a>
</div>

<div class="app-card p-3 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Buscar (documento, nombre, apellido o teléfono)</label>
            <input type="text" name="buscar" value="@buscar" class="form-control" placeholder="Ej.: 12345678 o Pérez" />
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="incluirInactivos" value="true" id="incluirInactivos" @(incluirInactivos ? "checked" : "") />
                <label class="form-check-label" for="incluirInactivos">Incluir inactivos</label>
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>
</div>

<div class="app-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Documento</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Teléfono</th>
                    <th>Fecha nac.</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center py-4 app-muted">No se encontraron pacientes.</td></tr>
            }
            else
            {
                foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Documento</td>
                        <td>@p.Nombres</td>
                        <td>@p.Apellidos</td>
                        <td>@p.Telefono</td>
                        <td>@(p.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>
                            @if (p.Activo) { <span class="badge bg-success">Activo</span> } else { <span class="badge bg-secondary">Inactivo</span> }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="CambiarEstado" method="post" class="d-inline" onsubmit="return confirm('@(p.Activo ? "¿Desactivar este paciente? Su historial se conservará." : "¿Activar este paciente?")');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <input type="hidden" name="activo" value="@(!p.Activo)" />
                                <button type="submit" class="btn btn-sm @(p.Activo ? "btn-outline-warning" : "btn-outline-success")">@(p.Activo ? "Desactivar" : "Activar")</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>