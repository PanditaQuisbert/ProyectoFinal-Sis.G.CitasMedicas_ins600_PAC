@model SistemaCitasMedicas.Datos.Entidades.Paciente
@{
    ViewData["Title"] = "Detalle del paciente";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Detalle del paciente</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>
<div class="app-card p-4">
    <dl class="row mb-0">
        <dt class="col-sm-4">Documento</dt><dd class="col-sm-8">@Model.Documento</dd>
        <dt class="col-sm-4">Nombres</dt><dd class="col-sm-8">@Model.Nombres</dd>
        <dt class="col-sm-4">Apellidos</dt><dd class="col-sm-8">@Model.Apellidos</dd>
        <dt class="col-sm-4">Teléfono</dt><dd class="col-sm-8">@Model.Telefono</dd>
        <dt class="col-sm-4">Fecha de nacimiento</dt><dd class="col-sm-8">@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No registrada")</dd>
        <dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@(Model.Activo ? "Activo" : "Inactivo")</dd>
    </dl>
</div>