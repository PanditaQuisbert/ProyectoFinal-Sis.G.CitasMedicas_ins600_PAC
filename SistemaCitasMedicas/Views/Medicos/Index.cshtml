@model IEnumerable<SistemaCitasMedicas.Datos.Entidades.Medico>
@{ ViewData["Title"] = "Médicos"; string buscar = ViewBag.Buscar as string ?? ""; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div><h2 class="mb-1">Médicos</h2><p class="app-muted mb-0">Registro y administración de médicos por especialidad.</p></div>
  <a asp-action="Create" class="btn btn-primary">Nuevo médico</a>
</div>
<div class="app-card p-3 mb-3">
  <form method="get" class="row g-2 align-items-end">
    <div class="col-md-4"><label class="form-label">Buscar</label><input name="buscar" value="@buscar" class="form-control" placeholder="Nombre, apellido o matrícula" /></div>
    <div class="col-md-4"><label class="form-label">Especialidad</label><select name="especialidadId" class="form-select" asp-items="ViewBag.Especialidades"><option value="">Todas</option></select></div>
    <div class="col-md-4 d-flex gap-2"><button class="btn btn-outline-primary" type="submit">Filtrar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
  </form>
</div>
<div class="app-card p-0 overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
<thead class="table-light"><tr><th>Médico</th><th>Matrícula</th><th>Especialidad</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
<tbody>
@if(!Model.Any()){<tr><td colspan="5" class="text-center py-4 app-muted">No hay médicos registrados.</td></tr>}
else{foreach(var m in Model){<tr>
<td>@m.NombreCompleto</td><td>@m.Matricula</td><td>@m.Especialidad?.Nombre</td>
<td>@(m.Activo?Html.Raw("<span class='badge bg-success'>Activo</span>"):Html.Raw("<span class='badge bg-secondary'>Inactivo</span>"))</td>
<td class="text-end">
  <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
  <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">Editar</a>
  <form asp-action="CambiarEstado" method="post" class="d-inline" onsubmit="return confirm('¿Confirmar cambio de estado?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@m.Id"/><input type="hidden" name="activo" value="@(!m.Activo)"/><button class="btn btn-sm @(m.Activo?"btn-outline-warning":"btn-outline-success")" type="submit">@(m.Activo?"Desactivar":"Activar")</button></form>
</td></tr>}}
</tbody></table></div></div>